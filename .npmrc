# The SDK is published to GitHub Packages. It is currently vendored under
# src/lib/srbijavoz-sdk (the CI token lacks `read:packages`). To use the
# published package instead, uncomment the auth line, export a GITHUB_TOKEN
# with `read:packages`, then `pnpm add @dusansimic/srbijavoz-sdk`.
@dusansimic:registry=https://npm.pkg.github.com
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
